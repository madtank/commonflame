# Local-only defaults. All host ports bind to loopback; do not expose this stack
# to a network without TLS and deployment-specific security review.
COMPOSE_PROJECT_NAME=waystation
WEB_PORT=3000
API_PORT=8001
MCP_PORT=8002
# Public origin only: no trailing slash or /mcp path.
PUBLIC_URL=http://localhost:3000
# Change this for a deployed installation. Signing secrets are generated at
# first boot and kept in the private signing-keys Docker volume.
POSTGRES_PASSWORD=waystation-local-only
LOG_LEVEL=INFO
